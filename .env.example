# Leave the Ray address empty for local planning. Use auto for a running cluster.
GEO_RAY_ADDRESS=

# Optional fixed survey and acquisition-policy checkpoint.
GEO_PROBLEM_JSON=
GEO_POLICY_CHECKPOINT=
GEO_PARTICLES=64

# Local Redis endpoint. Keep credentials in the environment.
GEO_REDIS_URL=redis://127.0.0.1:6379/0

# Application logging.
GEO_LOG_LEVEL=INFO
GEO_WORKERS=2
GEO_OUTPUT_DIR=outputs
GEO_API_URL=http://127.0.0.1:8000
GEO_CPU_THREADS=1
